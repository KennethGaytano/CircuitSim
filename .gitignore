# Editor / OS cruft
# Ignore the folder contents, but keep the shared Live Server port setting.
# (.vscode/ alone would stop git from re-including anything inside it.)
.vscode/*
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
npm-debug.log*

# Local environment files
.env
.env.local
